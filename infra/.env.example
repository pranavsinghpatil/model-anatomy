# Copy to infra/.env on the VM and chmod 600. Never commit live credentials.
DOMAIN=model-anatomy.example.com
ACME_EMAIL=operator@example.com
RELEASE_TAG=replace-with-release-id

# Supabase direct or session-pooler connection, never the transaction pooler.
# URL-encode password characters. SSL is required. No local PostgreSQL container.
MODEL_ANATOMY_DATABASE_URL=postgresql+psycopg://postgres.PROJECT:REPLACE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
MODEL_ANATOMY_SUPABASE_URL=https://PROJECT.supabase.co
MODEL_ANATOMY_SUPABASE_KEY=REPLACE_SERVER_ONLY_SERVICE_ROLE_KEY
MODEL_ANATOMY_SUPABASE_BUCKET=model-anatomy-private

MODEL_ANATOMY_NEBIUS_API_KEY=REPLACE_TOKEN_FACTORY_KEY
# Select an exact nvidia/... Nemotron ID returned by GET /v1/models.
MODEL_ANATOMY_NEBIUS_MODEL=nvidia/REPLACE_WITH_AVAILABLE_NEMOTRON_ID

# Guest quotas are hourly; global quotas are daily. Queue capacity counts WAITING jobs only.
MODEL_ANATOMY_GUEST_JOBS_PER_HOUR=2
MODEL_ANATOMY_GLOBAL_JOBS_PER_DAY=20
MODEL_ANATOMY_GUEST_QUESTIONS_PER_HOUR=10
MODEL_ANATOMY_GLOBAL_QUESTIONS_PER_DAY=100
MODEL_ANATOMY_QUEUE_CAPACITY=10
MODEL_ANATOMY_JOB_TIMEOUT_SECONDS=120
MODEL_ANATOMY_JOB_MEMORY_BYTES=4294967296
MODEL_ANATOMY_MAX_ATTEMPTS=2

# Keep real inspected reports for reuse while their immutable identity is unchanged.
# 0 = no automatic cache expiry. Visitor jobs still expire after 24 hours.
# A positive value opts into time-based retention and may require reinspection.
MODEL_ANATOMY_CACHE_TTL_SECONDS=0
