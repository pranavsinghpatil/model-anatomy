# Optional: copy this file to backend/.env. API and worker read it automatically.
# Existing environment variables override this file; missing files use defaults.
# Relative data paths resolve from the project root, independently of the launch directory.
MODEL_ANATOMY_PORT=8001
MODEL_ANATOMY_ENVIRONMENT=local
MODEL_ANATOMY_DATA_DIR=.local/model-anatomy
MODEL_ANATOMY_STORAGE_BACKEND=local
MODEL_ANATOMY_ALLOWED_HOSTS='["127.0.0.1","localhost","[::1]"]'
MODEL_ANATOMY_CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'

# Local SQLite requires no database server or cloud credentials.
# MODEL_ANATOMY_DATABASE_URL=sqlite:///.local/model-anatomy/jobs.sqlite3

# Optional manual exploration limits. Omit these to keep the normal defaults.
# MODEL_ANATOMY_GUEST_JOBS_PER_HOUR=100
# MODEL_ANATOMY_GLOBAL_JOBS_PER_DAY=500

# Optional AI explanations only. Graph inspection does not require these.
# NEBIUS_API_KEY=YOUR_SERVER_ONLY_KEY
# NEBIUS_MODEL=YOUR_AVAILABLE_NVIDIA_NEMOTRON_MODEL_ID
