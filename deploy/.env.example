# Copy to deploy/.env for local use. The real file is ignored by Git.
# In GitHub Actions, add these exact names as repository Secrets instead.
VERCEL_PROJECT_ID=prj_your_project_id
VERCEL_TEAM_ID=team_your_team_id
VERCEL_TOKEN=
# Your own project's Production origin; never reuse another account's domain.
# In Actions, put this public value in a repository Variable with the same name.
DEMO_PUBLIC_ORIGIN=https://your-demo.vercel.app
